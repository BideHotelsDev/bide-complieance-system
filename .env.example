# Copy to .env for local development. `pnpm dev:infra` prints the two URLs below.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres@localhost:5434/bide_comply
REDIS_URL=redis://127.0.0.1:6380/0
SESSION_SECRET=change-me-dev-only
WEB_BASE_URL=http://localhost:5180
FIELD_BASE_URL=http://localhost:5181
API_BASE_URL=http://localhost:8310
# Sign in as any seeded person without Google. Refused when ENVIRONMENT=production.
DEV_LOGIN=true

# Google Workspace SSO (OIDC + PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAINS=bidehotels.com

# Sign in with Bide (Bide Hub single sign-on). On when all three are set: it replaces the Google step for staff and
# Google sign-in is switched off; device codes, the authenticator app, break-glass and magic links are unchanged.
# With the Hub running locally: http://localhost:5190, comply, and the secret the Hub seeds, dev-secret-comply.
BIDE_HUB_ISSUER=
BIDE_HUB_CLIENT_ID=
BIDE_HUB_CLIENT_SECRET=
# true: the Hub also manages which staff have access and their staff roles. See infra/README.md.
BIDE_HUB_MANAGES_ACCOUNTS=false

# Evidence storage: local (writes .devdata/storage) or s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=eu-west-2
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email: console (logs) or smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Slack app. Empty: messages are logged.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_COMPLIANCE_CHANNEL=#bide-compliance
SLACK_ESCALATIONS_CHANNEL=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
